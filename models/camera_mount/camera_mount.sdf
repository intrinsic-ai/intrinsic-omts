<?xml version="1.0" ?>
<sdf xmlns:intrinsic="https://intrinsic.ai/" version="1.9">
  <model name="Sensor Mount">
    <link name="base_link">
      <visual name="base_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>camera_mount.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="cylinder_collision">
        <pose>0 0 0.032 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.064</length>
          </cylinder>
        </geometry>
      </collision>
      <collision name="box_collision">
        <pose>0 -0.09 0.04 0 0 0</pose>
        <geometry>
          <box>
            <size>0.12 0.06 0.10</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
