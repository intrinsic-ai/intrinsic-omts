<?xml version="1.0" ?>
<sdf xmlns:intrinsic="https://intrinsic.ai/" version="1.9">
  <model name="omts_enclosure">
    <link name="base_link">
      <visual name="base_visual">
        <geometry>
          <mesh>
            <uri>omts_enclosure.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="front_wall_collision">
        <pose>0 -0.6 1.6 0 0 0</pose>
        <geometry>
          <box>
            <size>1.6 0.05 1.2</size>
          </box>
        </geometry>
      </collision>
      <collision name="back_wall_collision">
        <pose>0 0.6 1.6 0 0 0</pose>
        <geometry>
          <box>
            <size>1.6 0.05 1.2</size>
          </box>
        </geometry>
      </collision>
      <collision name="left_wall_collision">
        <pose>-0.75 0 1.6 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 1.3 1.2</size>
          </box>
        </geometry>
      </collision>
      <collision name="right_wall_collision">
        <pose>0.75 0 1.6 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 1.3 1.2</size>
          </box>
        </geometry>
      </collision>
      <collision name="table_collision">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.6 1.3 0.05</size>
          </box>
        </geometry>
      </collision>
      <collision name="top_collision">
        <pose>0 0 2.1 0 0 0</pose>
        <geometry>
          <box>
            <size>1.6 1.3 0.05</size>
          </box>
        </geometry>
      </collision>
    </link>
    <frame name="robot_frame" attached_to="base_link" intrinsic:create_entity="true">
      <pose>0.0 0.0 1.005273 0.0 0.0 0.0</pose>
    </frame>
  </model>
</sdf>
