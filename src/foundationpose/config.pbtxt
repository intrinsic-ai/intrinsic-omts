name: "ai.intrinsic.ioc_pose_estimation.pose_estimator.foundationpose"
backend: "python"
default_model_filename: "model.py"

input [
  {
    name: "MASK"
    data_type: TYPE_UINT8
    dims: [-1, -1, -1]
  },
  {
    name: "RGB"
    data_type: TYPE_UINT8
    dims: [-1, -1, 3]
  },
  {
    name: "DEPTH"
    data_type: TYPE_FP32
    dims: [-1, -1]
  },
  {
    name: "CAM_K"
    data_type: TYPE_FP32
    dims: [3, 3]
  },
  {
    name: "CAD_MODEL_BYTES"
    data_type: TYPE_UINT8
    dims: [-1]
  },
  {
    name: "NUM_ITERATIONS"
    data_type: TYPE_INT32
    dims: [1]
    optional: true
  },
  {
    name: "BATCH_SIZE"
    data_type: TYPE_INT32
    dims: [1]
    optional: true
  }
]

output [
  {
    name: "ROTATION"
    data_type: TYPE_FP32
    dims: [-1, 3, 3]
  },
  {
    name: "TRANSLATION"
    data_type: TYPE_FP32
    dims: [-1, 3]
  },
  {
    name: "CONFIDENCE"
    data_type: TYPE_FP32
    dims: [-1, 1]
  }
]

parameters {
  key: "EXECUTION_ENV_PATH"
  value {
    string_value: "$$TRITON_MODEL_DIRECTORY/env.tar.gz"
  }
}

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
