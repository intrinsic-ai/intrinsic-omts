    pip,
    "ai_intrinsic_sdks_pip_deps",
)

# Base image for OMTS's own Python skills. @intrinsic-core pulls it for its
# //intrinsic/kubernetes:python3-image-oci, which is not visible outside it.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
use_repo(oci, "distroless_python3")
