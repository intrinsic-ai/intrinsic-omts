module(name = "omts")

# Intrinsic Core, pinned to an intrinsic-ai/ioc-staging revision.
#
# Intrinsic Core is built from source as part of the OMTS build. Bazel clones it directly,
# so no manual sibling checkout is required.
#
# INTRINSIC_CORE_COMMIT is pinned rather than the tag because git tags are mutable. It is
# the commit that `v0.0.1-rc5` points at:
#   git ls-remote https://github.com/intrinsic-ai/ioc-staging.git \
#     refs/tags/<tag>^{}
#
# ioc-staging is currently private, and its binary assets are stored in Git LFS,
# so fetching requires git credentials for the repository and a working
# `git-lfs` installation. See README.md for setup.
INTRINSIC_CORE_RELEASE = "20260918.0"  # buildifier: disable=unused-variable

INTRINSIC_CORE_COMMIT = "785c8db4eea01b40ff053086491468b50257ec89"

INTRINSIC_CORE_REMOTE = "https://github.com/intrinsic-ai/ioc-staging.git"

bazel_dep(name = "intrinsic-core")
git_override(
    module_name = "intrinsic-core",
    commit = INTRINSIC_CORE_COMMIT,
    patch_strip = 1,
    patches = ["//bazel/patches:robotiq_hande_finger_offset.patch"],
    remote = INTRINSIC_CORE_REMOTE,
)

bazel_dep(name = "intrinsic_apis", version = "0.0.1")
git_override(
    module_name = "intrinsic_apis",
    commit = INTRINSIC_CORE_COMMIT,
    remote = INTRINSIC_CORE_REMOTE,
    strip_prefix = "intrinsic_apis",
)

archive_override(
    module_name = "universal-robots-client-library",
    sha256 = "a7823035d5b157035448874b8ee622c2cd20e68fb10a2322a6efea3ea7fb1732",
    strip_prefix = "Universal_Robots_Client_Library-2.7.0-alpha-acceleration.0",
    url = "https://github.com/FilipposSot/Universal_Robots_Client_Library/archive/refs/tags/2.7.0-alpha-acceleration.0.tar.gz",
)

archive_override(
    module_name = "gloop",
    patch_strip = 1,
    patches = ["//bazel/patches:gloop.patch"],
    sha256 = "c4a32e9b582b2155dffa56867792a9d4d4931aa5575ade505a7672fce31d354d",
    strip_prefix = "gloop-20260828.0",
    urls = [
        "https://github.com/abseil/gloop/releases/download/20260828.0/gloop-20260828.0.tar.gz",
    ],
)

bazel_dep(name = "zenoh-c", version = "1.7.2.bcr.1")
single_version_override(
    module_name = "zenoh-c",
    patch_strip = 1,
    patches = ["//bazel/patches:zenohc.patch"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "abseil-py", version = "2.1.0", repo_name = "com_google_absl_py")
bazel_dep(name = "grpc", version = "1.69.0", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "toolchains_llvm", version = "1.6.0")
bazel_dep(name = "googleapis", version = "0.0.0-20260728-b8486a2f", repo_name = "com_google_googleapis")
bazel_dep(name = "protobuf", version = "32.1", repo_name = "com_google_protobuf")
single_version_override(
    module_name = "protobuf",
    version = "32.1",
)

bazel_dep(name = "rules_python", version = "1.9.2")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
use_repo(pip, "ai_intrinsic_sdks_pip_deps")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.redist_json(
    name = "cuda_12_8_1",
    components = [
        "cccl",
        "cudart",
        "nvcc",
        "curand",
    ],
    version = "12.8.1",
)
cuda.toolkit(
    name = "cuda",
)
use_repo(
    cuda,
    "cuda",
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    llvm_version = "19.1.0",
)

non_module_deps = use_extension("@intrinsic-core//bazel:non_module_deps.bzl", "non_module_deps_ext")
use_repo(
    non_module_deps,
    "intrinsic_llvm_sysroot",
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "foundationpose_refine_onnx",
    downloaded_file_path = "foundationpose_refine.onnx",
    sha256 = "06ad19f2c3598cb76733feec084d3f6802e7ff143882ec42ba368df7e38ae094",
    urls = [
        "https://api.ngc.nvidia.com/v2/models/nvidia/isaac/foundationpose/versions/1.0.0_onnx/files/refine_model.onnx",
    ],
)

http_file(
    name = "foundationpose_score_onnx",
    downloaded_file_path = "foundationpose_score.onnx",
    sha256 = "49a4f5f094358913670733ec31e856b96271c869f9949aa3a0361cf7cf8f0be8",
    urls = [
        "https://api.ngc.nvidia.com/v2/models/nvidia/isaac/foundationpose/versions/1.0.0_onnx/files/score_model.onnx",
    ],
)

llvm.sysroot(
    label = "@intrinsic_llvm_sysroot//:all_files",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

bazel_dep(name = "gazelle", version = "0.52.2", repo_name = "bazel_gazelle")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.gazelle_override(
    path = "github.com/grpc-ecosystem/grpc-gateway",
)
go_deps.gazelle_override(
    path = "github.com/cncf/xds/go",
)
go_deps.gazelle_override(
    build_file_generation = "on",
    directives = [
        "gazelle:prefix github.com/googlecloudrobotics/core/src",
    ],
    path = "github.com/googlecloudrobotics/core/src",
)

# Prebuilt asset bundles that are not built from source by this repository.
# They all live in a single release so that the pin can be moved atomically.
OMTS_ASSETS_RELEASE = "v0.0.3"

gh = use_extension("//bazel:gh_release.bzl", "gh_release")
gh.download(
    name = "flowstate_ros_bridge_bundle",
    pattern = "flowstate_ros_bridge.bundle.tar",
    repo = "intrinsic-ai/intrinsic-omts",
    sha256 = "ef2cabef6846d97994725984f769491dc90c73abc8ab195e14ac47770d94f183",
    tag = OMTS_ASSETS_RELEASE,
)
gh.download(
    name = "hand_e_gripper_cmd_skill_bundle",
    pattern = "hand_e_gripper_cmd_skill.bundle.tar",
    repo = "intrinsic-ai/intrinsic-omts",
    sha256 = "c3d3e3a853cef112deaa8b8263b661e4a2c3b035d1fe142a02314da819af6284",
    tag = OMTS_ASSETS_RELEASE,
)
gh.download(
    name = "hand_e_gripper_service_bundle",
    pattern = "hand_e_gripper_service.bundle.tar",
    repo = "intrinsic-ai/intrinsic-omts",
    sha256 = "e56f245bbaeee187c22e011a715f3c7bab4a96f0b52d7960dd27c5e9551259a1",
    tag = OMTS_ASSETS_RELEASE,
)
gh.download(
    name = "orbbec_gemini_driver_bundle",
    pattern = "orbbec_gemini_driver.bundle.tar",
    repo = "intrinsic-ai/intrinsic-omts",
    sha256 = "a7c30e1435d2f9d278b7999c02de7a90e24f9cba2ddbc9ba9f33f74fc68de031",
    tag = OMTS_ASSETS_RELEASE,
)
gh.download(
    name = "segmentation_weights_bundle",
    archive = True,
    pattern = "segmentation.tar.gz",
    repo = "intrinsic-ai/intrinsic-omts",
    sha256 = "b872cd424ad3c81e8a3f719394b459917107e832e868c9f427788156bd97283d",
    tag = OMTS_ASSETS_RELEASE,
)
gh.download(
    name = "foundationpose_py312_bundle",
    archive = True,
    pattern = "foundationpose_py312.tar.gz",
    repo = "intrinsic-ai/intrinsic-omts",
    sha256 = "e367c3dd6b98bbee3f603009ea670f38d604d2bbb8a5ef5f430cd3797833b17a",
    tag = "v0.0.2",
)
use_repo(
    gh,
    "flowstate_ros_bridge_bundle",
    "foundationpose_py312_bundle",
    "hand_e_gripper_cmd_skill_bundle",
    "hand_e_gripper_service_bundle",
    "orbbec_gemini_driver_bundle",
    "segmentation_weights_bundle",
)
