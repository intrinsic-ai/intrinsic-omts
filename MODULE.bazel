module(name = "omts")

# Intrinsic Core, pinned to an intrinsic-ai/intrinsic-core commit until the next
# GitHub Release (with pre-materialized Git LFS assets) is published.
#
# Intrinsic Core is built from source as part of the OMTS build. `git_override`
# is used for `intrinsic-core` so that Git LFS binary assets (meshes, textures)
# are smudged on checkout (GitHub's auto-generated `/archive/<commit>.tar.gz`
# endpoint only contains LFS pointer text files). `intrinsic_apis` contains only
# proto/BUILD text files and uses `archive_override` with `strip_prefix`.
#
# When bumping INTRINSIC_CORE_COMMIT, update INTRINSIC_CORE_SHA256 with:
#   curl -fsSL "https://github.com/intrinsic-ai/intrinsic-core/archive/<commit>.tar.gz" | sha256sum
INTRINSIC_CORE_COMMIT = "50927e35c5c85992b2a4d0b91dabb9cf4172b2d5"

INTRINSIC_CORE_URL = "https://github.com/intrinsic-ai/intrinsic-core/archive/{commit}.tar.gz".format(
    commit = INTRINSIC_CORE_COMMIT,
)

INTRINSIC_CORE_SHA256 = "3cd4921366ac2ad4786c44bb992f4f22b5e866f0bf9180cb5b11d5e39bdf2718"

bazel_dep(name = "intrinsic-core")
git_override(
    module_name = "intrinsic-core",
    commit = INTRINSIC_CORE_COMMIT,
    patch_strip = 1,
    patches = [
        "//bazel/patches:robotiq_hande_finger_offset.patch",
    ],
    remote = "https://github.com/intrinsic-ai/intrinsic-core.git",
)

bazel_dep(name = "intrinsic_apis", version = "0.0.1")
archive_override(
    module_name = "intrinsic_apis",
    sha256 = INTRINSIC_CORE_SHA256,
    strip_prefix = "intrinsic-core-{commit}/intrinsic_apis".format(commit = INTRINSIC_CORE_COMMIT),
    urls = [INTRINSIC_CORE_URL],
)

archive_override(
    module_name = "universal-robots-client-library",
    sha256 = "a7823035d5b157035448874b8ee622c2cd20e68fb10a2322a6efea3ea7fb1732",
    strip_prefix = "Universal_Robots_Client_Library-2.7.0-alpha-acceleration.0",
    url = "https://github.com/FilipposSot/Universal_Robots_Client_Library/archive/refs/tags/2.7.0-alpha-acceleration.0.tar.gz",
)

archive_override(
    module_name = "gloop",
    patch_strip = 1,
    patches = ["//bazel/patches:gloop.patch"],
    sha256 = "c4a32e9b582b2155dffa56867792a9d4d4931aa5575ade505a7672fce31d354d",
    strip_prefix = "gloop-20260828.0",
    urls = [
        "https://github.com/abseil/gloop/releases/download/20260828.0/gloop-20260828.0.tar.gz",
    ],
)

bazel_dep(name = "zenoh-c", version = "1.8.0.bcr.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "abseil-py", version = "2.1.0", repo_name = "com_google_absl_py")
bazel_dep(name = "eigen", version = "5.0.1.bcr.2", repo_name = "com_gitlab_libeigen_eigen")
bazel_dep(name = "grpc", version = "1.81.1", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "pybind11_bazel", version = "3.0.3")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "rules_python", version = "2.3.3")
# Bzlmod ignores `single_version_override` directives in non-root modules
# (@intrinsic-core), so the overrides below are mirrored from
# @intrinsic-core//MODULE.bazel until the upstream fixes land in the Bazel
# Central Registry (BCR) and @intrinsic-core bumps its `bazel_dep` versions.

# TODO(b/568016456): Remove this override and
# //bazel/patches:llvm_header_search_paths.patch once
# https://github.com/hermeticbuild/hermetic-llvm/pull/806 is released in
# llvm > 0.8.24 on BCR and @intrinsic-core upgrades `llvm`. Without it,
# glibc's <error.h> shadows BCR package headers (e.g. @osqp//include/error.h).
bazel_dep(name = "llvm", version = "0.8.24")
single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = [
        "//bazel/patches:llvm_header_search_paths.patch",
    ],
    version = "0.8.24",
)

bazel_dep(name = "googleapis", version = "0.0.0-20260929-28769825", repo_name = "com_google_googleapis")

# TODO(b/388805879): Remove this override once
# https://github.com/protocolbuffers/protobuf/issues/24084 is resolved in BCR
# and @intrinsic-core upgrades `protobuf`.
bazel_dep(name = "protobuf", version = "33.6", repo_name = "com_google_protobuf")
single_version_override(
    module_name = "protobuf",
    patch_cmds = [
        "sed -i 's|@system_python//:python_headers|@rules_python//python/cc:current_py_cc_headers|g' python/build_targets.bzl python/py_extension.bzl",
    ],
    version = "33.6",
)

# Remove once opencv@4.13+ on BCR carries the webp/Qt6 patches and
# @intrinsic-core drops its single_version_override on `opencv`.
single_version_override(
    module_name = "opencv",
    version = "4.12.0.bcr.5",
)

# TODO(b/567681750): Remove once `libxml2-go` on BCR supports libxml2 >= 2.15
# under Clang 21 and @intrinsic-core drops its override on `libxml2`.
single_version_override(
    module_name = "libxml2",
    version = "2.14.4.bcr.1",
)

# TODO(b/567681027): Remove this override and
# //bazel/patches:toybox_dynamic_link.patch once toybox on BCR links against
# @libxcrypt under hermetic llvm and @intrinsic-core upgrades `toybox`.
single_version_override(
    module_name = "toybox",
    patch_strip = 1,
    patches = [
        "//bazel/patches:toybox_dynamic_link.patch",
    ],
    version = "0.8.12.bcr.1",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

internal_configure = use_extension("@pybind11_bazel//:internal_configure.bzl", "internal_configure_extension")
use_repo(internal_configure, "pybind11")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.redist_json(
    name = "cuda_12_8_1",
    components = [
        "cccl",
        "cudart",
        "nvcc",
        "curand",
    ],
    version = "12.8.1",
)
cuda.toolkit(
    name = "cuda",
)
use_repo(
    cuda,
    "cuda",
)

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "21.1.8")
llvm.configure(
    targets = [
        "X86",
    ],
)
use_repo(llvm, "llvm-project")

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.gazelle_override(
    path = "github.com/grpc-ecosystem/grpc-gateway",
)
go_deps.gazelle_override(
    path = "github.com/cncf/xds/go",
)
go_deps.gazelle_override(
    build_file_generation = "on",
    directives = [
        "gazelle:prefix github.com/googlecloudrobotics/core",
    ],
    path = "github.com/googlecloudrobotics/core",
)

