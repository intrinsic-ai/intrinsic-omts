# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates
# Lab waypoints for the mesh grasping demo workpieces, which replace the raw
# stock that configs/lab_bb_01/scene.updates.pbtxt places. The grasp frames are
# placeholders; the grasp planner overwrites them.
updates {
  create_frame {
    new_frame_name: "grasp"
    parent_t_new_frame {
      position { x: 0.25 y: 0.25 z: 0.706 }
      orientation { x: 1.0 }
    }
    parent_object_with_filter { reference { by_name { object_name: "root" } } }
  }
}
